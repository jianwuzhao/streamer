{
  "name": "dsh-dafeiyu-evolve",
  "version": "0.9.1",
  "description": "大肥鱼自学习直播系统：本地优先推理、统一记忆、技能库、观众画像、训练与自动发布（DSH 插件，阶段 A 基础层）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "config",
    "policy-packs",
    "skill-packages",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "client"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:worker": "python3 -m unittest discover -s training-worker -p 'test_*.py' -v",
    "typecheck": "tsc --noEmit",
    "migrate:check": "node --test \"src/storage/*.test.ts\""
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}