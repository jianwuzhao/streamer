{
  "name": "dsh-dafeiyu-evolve",
  "version": "0.19.0",
  "description": "大肥鱼自学习直播系统：鹅次元式角色档案（含 dsh-pet 插件中桌宠）、本地优先推理、统一记忆、技能库、观众画像、训练与自动发布（DSH 插件）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "config",
    "policy-packs",
    "skill-packages",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "client",
    "scripts/synthesize-role-voice.py",
    "scripts/setup-role-voices.sh",
    "scripts/prepare-role-prototypes.mjs",
    "scripts/prepare-role-motion.swift",
    "scripts/build-broadcast-window.mjs",
    "scripts/broadcast-window.swift",
    "scripts/setup-ollama.mjs",
    "scripts/build-face-rigs.mjs",
    "scripts/extract-face-landmarks.swift",
    "scripts/build-face-rig-preview.mjs"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup:ollama": "node scripts/setup-ollama.mjs",
    "build": "tsdown && node scripts/build-broadcast-window.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:worker": "python3 -m unittest discover -s training-worker -p 'test_*.py' -v",
    "typecheck": "tsc --noEmit",
    "migrate:check": "node --test \"src/storage/*.test.ts\"",
    "avatar:build": "node scripts/build-face-rigs.mjs",
    "avatar:build-3d": "node scripts/build-rigged-avatar.mjs",
    "avatar:verify": "node scripts/verify-face-rigs.mjs",
    "avatar:preview": "node scripts/build-face-rig-preview.mjs"
  },
  "dependencies": {
    "playwright-core": "1.65.0",
    "protobufjs": "7.6.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
